#!/usr/bin/env python3
"""mytools — subset reimplementation of bedtools."""

import sys

VERSION = "0.1.0"


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv

    if argv == ["--version"]:
        print(f"mytools {VERSION}")
        return 0

    print("usage: mytools --version", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
